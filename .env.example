# Public Supabase project URL
NEXT_PUBLIC_SUPABASE_URL=

# Public Supabase publishable key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase secret key.
# Never expose this value to the browser or commit a real secret.
SUPABASE_SECRET_KEY=

# Comma-separated production administrator emails.
# For a client transfer, set this to the client's owner/admin accounts.
MARKETPLACE_ADMIN_EMAILS=

# Optional legacy alias retained during migration.
UTECH_ADMIN_EMAILS=

# Client-owned marketplace identity
NEXT_PUBLIC_MARKETPLACE_NAME=
NEXT_PUBLIC_MARKETPLACE_TAGLINE=
NEXT_PUBLIC_MARKETPLACE_DESCRIPTION=
NEXT_PUBLIC_MARKETPLACE_LOGO_URL=
NEXT_PUBLIC_MARKETPLACE_DOMAIN=
NEXT_PUBLIC_MARKETPLACE_SUPPORT_EMAIL=
NEXT_PUBLIC_MARKETPLACE_SUPPORT_PHONE=
NEXT_PUBLIC_MARKETPLACE_CURRENCY=GHS
NEXT_PUBLIC_MARKETPLACE_COUNTRY=Ghana

# UTECH developer attribution
NEXT_PUBLIC_DEVELOPER_NAME=UTECH
NEXT_PUBLIC_DEVELOPER_URL=
